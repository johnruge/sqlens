# Copy to .env and fill in real values. Never commit .env.
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=sakila
MYSQL_USER=changeme
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1

# Read-only account sqlens should connect with (SELECT + SHOW VIEW only).
SQLENS_RO_USER=sqlens_ro
SQLENS_RO_PASSWORD=changeme

# Optional: enables AI suggestions. Leave empty to use only the built-in analyzer.
GEMINI_API_KEY=
